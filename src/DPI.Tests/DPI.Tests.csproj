<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>DPI.Tests</RootNamespace>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>$([System.DateTime]::UtcNow.AddMonths(6).ToString('yyyy-MM'))</Verify_SponsorshipExemptionUntil>
    <Verify_DisableUniqueForTargetFrameworkAndVersion>true</Verify_DisableUniqueForTargetFrameworkAndVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Routes.json" />
    <EmbeddedResource Include="Resources\Empty.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Cake.Testing" />
    <Using Include="DPI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cake.Bridge.DependencyInjection.Testing" Version="2026.10.15.869" />
    <PackageReference Include="Cake.Testing" Version="6.3.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Devlead.Testing.MockHttp" Version="2026.10.15.1037" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Verify.DiffPlex" Version="3.4.0" />
    <PackageReference Include="Verify.XunitV3" Version="33.3.4" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DPI\DPI.csproj" />
  </ItemGroup>

</Project>
